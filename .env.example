# =========================================================================
# AlphaForge AI - Root Environment Config Blueprint
# Copy this to frontend/.env and backend/.env as required.
# =========================================================================

# ─── FRONTEND CONFIG (Copy to AlphaForge-AI/frontend/.env) ───────────────
VITE_API_URL=http://localhost:5000

# ─── BACKEND CONFIG (Copy to AlphaForge-AI/backend/.env) ──────────────────
PORT=5000
NODE_ENV=development

# Gemini API Key (Required for primary orchestration)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq API Key (Optional fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Alpha Vantage API Key (Required for primary financials)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# NewsAPI Key (Required for sentiment timeline)
NEWS_API_KEY=your_news_api_key_here
NEWS_API_BASE_URL=https://newsapi.org/v2

# Financial Modeling Prep Key (Optional fallback)
FMP_API_KEY=your_fmp_api_key_here
FMP_BASE_URL=https://financialmodelingprep.com/stable

# CORS Settings
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_RETRIES=2
REQUEST_TIMEOUT_MS=15000
