# AlphaForge AI — Backend Environment Variables
# Copy this file to .env and fill in your API keys

# ─── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PRIMARY LLM: Google Gemini ───────────────────────────────────
# Free tier: 1M tokens/day — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── FALLBACK LLM #1: OpenAI (Optional) ───────────────────────────
# Pay-per-use — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── FALLBACK LLM #2: Groq (Optional - FREE) ──────────────────────
# 14,400 req/day free — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Financial Data: Alpha Vantage ────────────────────────────────
# Free: 25 req/day — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# ─── News Data: NewsAPI.org ───────────────────────────────────────
# Free: 100 req/day — https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here
NEWS_API_BASE_URL=https://newsapi.org/v2

# ─── Financial Data: Financial Modeling Prep (FMP) (Optional) ─────
# Free: 250 req/day — https://financialmodelingprep.com/developer/docs
# Used as fallback for company profile, financials, and competitor peers
FMP_API_KEY=your_fmp_api_key_here
FMP_BASE_URL=https://financialmodelingprep.com/stable

# ─── CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Analysis Settings ────────────────────────────────────────────
MAX_RETRIES=2
REQUEST_TIMEOUT_MS=15000
